# ────────────────────────────────────────────────────
# PathForge Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit the real .env file.
# ────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=5000

# MongoDB (local Docker or Atlas URI)
MONGO_URI=mongodb://localhost:27017/pathforge

# Redis (local Docker or Redis Cloud URI)
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=your-access-secret-at-least-32-chars-long-replace-this
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars-long-replace-this
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Cluster matching confidence threshold (0.0 - 1.0)
CLUSTER_MATCH_THRESHOLD=0.82

# Email (SendGrid or Resend API key)
EMAIL_PROVIDER_API_KEY=your-email-provider-api-key
EMAIL_FROM_ADDRESS=noreply@pathforge.dev

# Cloudinary (for avatar uploads)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Client URL (for CORS and email links)
CLIENT_URL=http://localhost:5173

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sentry DSN (error tracking)
SENTRY_DSN=
